{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,

    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    "types": ["@cloudflare/workers-types", "astro/client"],

    "baseUrl": ".",
    "paths": {
      "@api/*": ["src/api/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", ".astro"]
}
