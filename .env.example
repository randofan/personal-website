# Public variables — accessible in the browser via import.meta.env.PUBLIC_*
PUBLIC_SITE_URL=http://localhost:4321

# Chrome origin trial token for WebMCP (register the production domain at
# https://developer.chrome.com/origintrials/#/register_trial/4163014905550602241).
# Without it, WebMCP only works in browsers with chrome://flags/#enable-webmcp-testing on.
# PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN=

# Private variables — accessible in Hono via c.env.* (never sent to the browser)
# MY_SECRET_KEY=replace_me
